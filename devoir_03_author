*{
    padding: 0;
    margin: 0;
    box-sizing: border-box;
}

ul{
    display: flex;
    flex-direction: row;
    justify-content: left;
    list-style: none;
    gap: 10px; 
}

a:hover {
    background-color: blue;
    height: 15px;
    color: white;
}   

a{
    color: black;
    list-style: none;
    padding: 15px;
    margin-left: 4px;
    text-decoration: none;
}

li ::after  {
    content:"|";
}

